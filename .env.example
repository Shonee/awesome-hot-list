# 本地调试时复制为 .env；不要把真实凭证提交到 Git。
HOTLIST_WRITE=1

# 可选。配置后优先读取知乎官方热榜；留空或失效时使用今日热榜降级源。
ZHIHU_COOKIE=

# 今日热榜等共享降级源的最小请求间隔（秒），建议不要低于默认值 3。
HOTLIST_TOPHUB_MIN_INTERVAL_SECONDS=3

# DailyHot API 等共享第三方源的最小请求间隔（秒），建议不要低于默认值 5。
HOTLIST_DAILYHOT_MIN_INTERVAL_SECONDS=5

# 仅在手动启用脉脉采集时配置。该渠道接口稳定性较低。
MAIMAI_COOKIE=
