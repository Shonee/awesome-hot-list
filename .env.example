# 本地调试时复制为 .env；不要把真实凭证提交到 Git。
HOTLIST_WRITE=1

# 可选。配置后优先读取知乎官方热榜；留空或失效时使用今日热榜降级源。
ZHIHU_COOKIE=

# 今日热榜等共享降级源的最小请求间隔（秒），建议不要低于默认值 3。
HOTLIST_TOPHUB_MIN_INTERVAL_SECONDS=3

# DailyHot API 等共享第三方源的最小请求间隔（秒），建议不要低于默认值 5。
HOTLIST_DAILYHOT_MIN_INTERVAL_SECONDS=5

# 全站通用的域名请求间隔（秒），CI 里默认 1；设为 0 关闭闸门。
HOTLIST_DOMAIN_MIN_INTERVAL_SECONDS=1

# 域名被 403/429 冷却后，单次请求最多愿意等待的秒数（默认 30）。
# 超出则本渠道直接按 rate_limited 失败，避免整批任务被拖到 job 超时。
HOTLIST_DOMAIN_MAX_WAIT_SECONDS=30

# 单批采集的秒数预算（默认不设限）。到期后剩余渠道记 deadline 错误并立即收尾，
# 保证已有数据能落盘推送，而不是被 timeout-minutes 连任务一起杀掉。
HOTLIST_COLLECT_BUDGET_SECONDS=

# 判定"这批采集出事"的退出码阈值：失败数同时达到 minimum 且比例达到 ratio 才返回 1
# （默认 3 与 0.5）；全军覆没无论批次大小都返回 1。
HOTLIST_FAILURE_MIN=3
HOTLIST_FAILURE_RATIO=0.5

# 仅在手动启用脉脉采集时配置。该渠道接口稳定性较低。
MAIMAI_COOKIE=
