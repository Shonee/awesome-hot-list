10"},{"rank":3,"title":"伊朗总统：不再信任同美国的对话","url":"https://www.cls.cn/detail/2493323","hot":529739,"description":"【伊朗总统：不再信任同美国的对话】财联社9月26日电，据伊朗方面26日消息，伊朗总统佩泽希齐扬在接受采访时表示，鉴于每一轮谈判后美国都会发动袭击并实施制裁，伊朗不再信任与美国的对话。\n\n佩泽希齐扬透露，卡塔尔和巴基斯坦目前正在伊朗与美国之间进行斡旋。谈判基于此前同美国签署的谅解备忘录，“美方必须就此表明立场”。\n\n在回答是否可能同美国总统特朗普举行会晤的问题时，佩泽希齐扬说：“我为什么要与美国总统会面？目的何在？当初我们签署协议，他们却未能履行承诺。”\n\n佩泽希齐扬强调，霍尔木兹海峡问题只有通过谈判才能解决，而非动用武力。“当各条通道对伊朗关闭时，关闭霍尔木兹海峡是自然反应。”\n\n佩泽希齐扬还","imageUrl":"","publishedAt":"2026-09-26 23:36:35"},{"rank":4,"title":"巴布亚新几内亚发生5.6级地震","url":"https://www.cls.cn/detail/2493321","hot":533751,"description":"【巴布亚新几内亚发生5.6级地震】财联社9月26日电，据欧洲-地中海地震中心测定，当地时间9月27日0时08分，巴布亚新几内亚新不列颠地区发生5.6级地震，震源深度58千米，震中位于南纬4.6744度，东经152.799度。","imageUrl":"","publishedAt":"2026-09-26 22:57:06"}]}]},{"schemaVersion":1,"channelId":"yicai","channelName":"第一财经","sourceUrl":"https://www.yicai.com/","fetchedAt":"2026-09-27 01:48:28","status":"ok","error":"","warnings":[],"health":{"durationMs":4571.2,"itemCount":3,"provider":"第一财经官方","failureCount":0},"rankings":[{"id":"live","name":"7x24","sourceUrl":"https://www.yicai.com/brief/","providerName":"第一财经官方","providerUrl":"https://www.yicai.com/api/ajax/getbrieflist?page=1&pagesize=20&type=0&id=all&action=mix","surface":"live","items":[{"rank":1,"title":"福建罗源县碧里乡发生滑坡泥石流险情 3人暂未联系上","url":"https://m.yicai.com/brief/103378625.html","hot":null,"description":"","imageUrl":"","publishedAt":"2026-09-26T23:56:58"},{"rank":2,"title":"巴布亚新几内亚发生5.6级地震","url":"https://m.yicai.com/brief/103378621.html","hot":null,"description":"","imageUrl":"","publishedAt":"2026-09-26T23:04:41"},{"rank":3,"title":"特朗普称拒绝伊朗重开霍尔木兹海峡的提议","url":"https://m.yicai.com/brief/103378619.html","hot":null,"description":"","imageUrl":"","publishedAt":"2026-09-26T22:52:03"}]}]},{"schemaVersion":1,"channelId":"wallstreetcn","channelName":"华尔街见闻","sourceUrl":"https://wallstreetcn.com/live/global","fetchedAt":"2026-09-27 01:08:00","status":"stale","error":"source returned no usable items","warnings":[],"health":{"durationMs":1215.8